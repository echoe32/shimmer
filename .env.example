# Example settings for shimmer. Copy this file to .env, which git ignores:
#
#     cp .env.example .env
#
# shimmer reads .env from the directory it runs in, so run it from the project
# root, or in Docker, where the project root is /data.
#
# Each variable stands in for the flag named beside it. A flag typed on the
# command line wins over this file, and so does a variable already set in the
# environment. This file wins over a -config JSON file. An empty value, or a
# line commented out, leaves the setting at its default.
#
# Relative paths are resolved from the directory shimmer runs in, not from here.
# See "Environment and .env file" in PROJECT.md.

# Geo databases: country and ASN for each proxy's exit address.
SHIMMER_MMDB_CITY=GeoLite2-Country.mmdb # -mmdb-city; GeoLite2-City.mmdb gives the same country
SHIMMER_MMDB_ASN=GeoLite2-ASN.mmdb      # -mmdb-asn

# Input and output.
# SHIMMER_INPUT=proxies.txt             # -i; default "-", stdin
# SHIMMER_OUTPUT=results.jsonl          # -o; default "-", stdout, or none with only SHIMMER_DB
# SHIMMER_DB=proxies.db                 # -db; SQLite database kept across runs
# SHIMMER_FORMAT=jsonl                  # -format; jsonl or csv

# Checking.
# SHIMMER_WORKERS=512                   # -workers; lowered to fit the open-file limit
# SHIMMER_TIMEOUT=10s                   # -timeout; Go duration, e.g. 1500ms, 1m
# SHIMMER_EXIT_IP=false                 # -exit-ip; true asks api.ipify.org through each live proxy
# SHIMMER_SKIP=                         # -skip; e.g. socks4,http
# SHIMMER_FETCH=4                       # -fetch; list downloads at once, with -lists

# Reporting.
# SHIMMER_ALIVE_ONLY=false              # -alive-only
# SHIMMER_QUIET=false                   # -quiet

# A JSON config file to load first, for settings this file does not set.
# SHIMMER_CONFIG=shimmer.json           # -config
